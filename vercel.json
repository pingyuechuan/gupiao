{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/em/:path*", "destination": "/api/gw?slug=em/:path*" },
    { "source": "/emh/:path*", "destination": "/api/gw?slug=emh/:path*" },
    { "source": "/ems/:path*", "destination": "/api/gw?slug=ems/:path*" },
    { "source": "/sina/:path*", "destination": "/api/gw?slug=sina/:path*" },
    { "source": "/tc/:path*", "destination": "/api/gw?slug=tc/:path*" },
    { "source": "/tk/:path*", "destination": "/api/gw?slug=tk/:path*" },
    { "source": "/sk/:path*", "destination": "/api/gw?slug=sk/:path*" },
    { "source": "/ths/:path*", "destination": "/api/gw?slug=ths/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
