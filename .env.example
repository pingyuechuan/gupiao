# ============================================================
# Project Phoenix — 环境变量
# 复制为 .env.local（本地）或填入 Vercel > Settings > Environment Variables（生产）
# ============================================================

# ---- 行情数据源 ----
# eastmoney | sina | tencent | akshare | tonghuashun
VITE_DEFAULT_PROVIDER=tonghuashun

# AKShare 后端地址（可选，仅当 provider=akshare 时需要）
VITE_AKSHARE_BASE_URL=http://localhost:8000

# ---- Supabase 认证（V0.8 起）----
# 取值位置：Supabase Dashboard > Project Settings > API
# 两者都留空时，应用会跳过登录门禁（仅建议本地开发这么做）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
